# ──────────────────────────────────────────────────────────────
# Axis Solutions Traccar — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# PostgreSQL credentials (used by both the postgres and traccar services)
TRACCAR_DB_NAME=traccar
TRACCAR_DB_USER=traccar
TRACCAR_DB_PASS=CHANGE_ME_STRONG_PASSWORD

# Use http://localhost:8082 locally and the final HTTPS URL in Coolify.
TRACCAR_PUBLIC_URL=https://gps.devaxis.co.zm
